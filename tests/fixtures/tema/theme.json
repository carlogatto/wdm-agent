{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1434px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "base",
          "color": "#f5f7fa",
          "name": "Base"
        },
        {
          "slug": "surface",
          "color": "#ffffff",
          "name": "Surface"
        },
        {
          "slug": "main",
          "color": "#0f172a",
          "name": "Main"
        },
        {
          "slug": "muted",
          "color": "#475569",
          "name": "Muted"
        },
        {
          "slug": "border",
          "color": "#e2e8f0",
          "name": "Border"
        },
        {
          "slug": "accent",
          "color": "#4f46e5",
          "name": "Accent"
        },
        {
          "slug": "dark",
          "color": "#0f172a",
          "name": "Dark"
        },
        {
          "slug": "accent-dark",
          "color": "#22d3ee",
          "name": "Accent dark"
        }
      ],
      "custom": false,
      "customGradient": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "link": true
    },
    "typography": {
      "fluid": true,
      "customFontSize": false,
      "lineHeight": false,
      "fontFamilies": [
        {
          "fontFamily": "\"IBM Plex Sans\", system-ui, sans-serif",
          "slug": "plex-sans",
          "name": "IBM Plex Sans",
          "fontFace": [
            {
              "fontFamily": "IBM Plex Sans",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/IBMPlexSans-Regular.woff2"
              ]
            },
            {
              "fontFamily": "IBM Plex Sans",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/IBMPlexSans-Medium.woff2"
              ]
            },
            {
              "fontFamily": "IBM Plex Sans",
              "fontStyle": "normal",
              "fontWeight": "600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/IBMPlexSans-SemiBold.woff2"
              ]
            },
            {
              "fontFamily": "IBM Plex Sans",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/IBMPlexSans-Bold.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
          "slug": "plex-mono",
          "name": "IBM Plex Mono",
          "fontFace": [
            {
              "fontFamily": "IBM Plex Mono",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/IBMPlexMono-Regular.woff2"
              ]
            },
            {
              "fontFamily": "IBM Plex Mono",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/IBMPlexMono-Medium.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.937rem",
          "name": "Small",
          "fluid": {
            "min": "0.875rem",
            "max": "0.937rem"
          }
        },
        {
          "slug": "medium",
          "size": "1.062rem",
          "name": "Medium",
          "fluid": {
            "min": "0.937rem",
            "max": "1.062rem"
          }
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Large",
          "fluid": {
            "min": "1.125rem",
            "max": "1.25rem"
          }
        },
        {
          "slug": "extra-large",
          "size": "2rem",
          "name": "Extra large",
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          }
        },
        {
          "slug": "extra-extra-large",
          "size": "2.5rem",
          "name": "Extra Extra large",
          "fluid": {
            "min": "2rem",
            "max": "2.5rem"
          }
        },
        {
          "slug": "display",
          "size": "4rem",
          "name": "Display",
          "fluid": {
            "min": "2.5rem",
            "max": "4rem"
          }
        }
      ],
      "dropCap": false,
      "fontStyle": true,
      "fontWeight": true,
      "textTransform": true,
      "textDecoration": true,
      "letterSpacing": false,
      "writingMode": false,
      "defaultFontSizes": false
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "customSpacingSize": false,
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "slug": "xs",
          "size": "0.9375rem",
          "name": "XS (15px)"
        },
        {
          "slug": "sm",
          "size": "1.875rem",
          "name": "SM (30px)"
        },
        {
          "slug": "md",
          "size": "2.8125rem",
          "name": "MD (45px)"
        },
        {
          "slug": "lg",
          "size": "3.75rem",
          "name": "LG (60px)"
        },
        {
          "slug": "xl",
          "size": "5.625rem",
          "name": "XL (90px)"
        },
        {
          "slug": "section-sm",
          "size": "clamp(0.9375rem, -0.8807rem + 5.0505vw, 2.8125rem)",
          "name": "Sezione S (15→45px)"
        },
        {
          "slug": "section-lg",
          "size": "clamp(2.8125rem, 0.085rem + 7.5758vw, 5.625rem)",
          "name": "Sezione L (45→90px)"
        }
      ],
      "defaultSpacingSizes": false
    },
    "custom": {
      "radius": {
        "sm": "6px",
        "md": "8px",
        "lg": "12px",
        "pill": "50rem"
      },
      "shadow": {
        "sm": "0 1px 2px rgba(15, 23, 42, 0.06)",
        "md": "0 1px 3px rgba(15, 23, 42, 0.08), 0 8px 24px -12px rgba(15, 23, 42, 0.12)",
        "lg": "0 12px 40px -16px rgba(15, 23, 42, 0.18)"
      },
      "transition": {
        "base": "all .2s ease-in-out"
      },
      "zIndex": {
        "header": "1020",
        "dialog": "1050"
      },
      "headerHeight": {
        "mobile": "60px",
        "desktop": "90px"
      },
      "breakpoints": {
        "xs": "480px",
        "sm": "576px",
        "md": "768px",
        "lg": "992px",
        "xl": "1170px",
        "xxl": "1434px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--main)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--main)"
        },
        ":hover": {
          "typography": {
            "textDecoration": "none"
          }
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var(--wp--preset--color--main)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--display)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--extra-extra-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--extra-large)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--surface)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "500",
          "textDecoration": "none"
        },
        "border": {
          "radius": "var(--wp--custom--radius--md)",
          "width": "0"
        },
        "spacing": {
          "padding": {
            "top": "0.625rem",
            "bottom": "0.625rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--main)",
            "text": "var(--wp--preset--color--surface)"
          }
        }
      }
    },
    "typography": {
      "fontSize": "var(--wp--preset--font-size--medium)",
      "fontFamily": "var(--wp--preset--font-family--plex-sans)",
      "lineHeight": "1.7",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--sm)",
      "padding": {
        "left": "var(--wp--preset--spacing--xs)",
        "right": "var(--wp--preset--spacing--xs)",
        "top": "0px",
        "bottom": "0px"
      }
    },
    "blocks": {
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--main)",
            "width": "5px",
            "style": "solid"
          }
        },
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--sm)"
          }
        }
      },
      "core/buttons": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--xs)"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--main)"
        }
      },
      "core/site-title": {
        "typography": {
          "fontWeight": "700",
          "textDecoration": "none"
        }
      },
      "core/navigation": {
        "typography": {
          "fontWeight": "600"
        }
      },
      "wdm/hero": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|section-lg",
            "bottom": "var:preset|spacing|section-lg"
          }
        }
      },
      "wdm/image-text": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|section-lg",
            "bottom": "var:preset|spacing|section-lg"
          }
        }
      },
      "wdm/columns-wrapper": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|section-lg",
            "bottom": "var:preset|spacing|section-lg"
          }
        }
      },
      "wdm/cards-carousel": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|section-lg",
            "bottom": "var:preset|spacing|section-lg"
          }
        }
      },
      "wdm/form": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|section-lg",
            "bottom": "var:preset|spacing|section-lg"
          }
        }
      },
      "wdm/cta": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|section-lg",
            "bottom": "var:preset|spacing|section-lg"
          }
        }
      },
      "wdm/features": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|section-lg",
            "bottom": "var:preset|spacing|section-lg"
          }
        }
      },
      "wdm/steps": {
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|section-lg",
            "bottom": "var:preset|spacing|section-lg"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "form-contacts",
      "title": "Form di default",
      "area": "uncategorized"
    }
  ]
}
